{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Type check build",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"-s",
				"tsc",
				"--noEmit"
			],
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "ESLint fix",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"-s",
				"run",
				"lint"
			],
			"problemMatcher": [
				"$eslint-stylish"
			],
			"group": "build"
		}
	]
}